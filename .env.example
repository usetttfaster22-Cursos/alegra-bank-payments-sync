# Puerto donde escucha la aplicación dentro del contenedor (no lo cambies)
PORT=3000

# Puerto del HOST (tu servidor) que se mapea al contenedor. Cámbialo si el 3000
# ya está ocupado por otra cosa en tu servidor, ej: HOST_PORT=8080
HOST_PORT=3000

# Credenciales de la API de Alegra (Configuración > API en tu cuenta de Alegra)
ALEGRA_EMAIL=tu-usuario@tuempresa.com
ALEGRA_TOKEN=tu-token-de-api-de-alegra
ALEGRA_BASE_URL=https://api.alegra.com/api/v1

# Mientras validas el mapeo con tu cuenta real de Alegra, deja esto en true:
# no se envía nada a Alegra, solo se registra en consola/log el payload que se enviaría.
DRY_RUN=true

# Ruta del archivo de base de datos SQLite (se guarda dentro del volumen del contenedor)
DATABASE_PATH=/app/data/app.db

# Usuario y clave para proteger la pantalla web (autenticación básica)
BASIC_AUTH_USER=admin
BASIC_AUTH_PASSWORD=cambia-esta-clave
